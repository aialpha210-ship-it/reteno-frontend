# Copy this file to .env.local for local development. Never commit .env.local.

# Base URL of the FastAPI backend. Only NEXT_PUBLIC_* values are ever safe
# here — anything without that prefix would be a server-only secret, and the
# frontend currently has no server-only secrets to store.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Supabase browser credentials. These are safe to expose in the browser;
# never add a service-role or secret key to this file.
NEXT_PUBLIC_SUPABASE_URL=https://arstwwjiqahlrxxgyhfi.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
